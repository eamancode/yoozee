{
 "title": "七床",
 "scenes": [
  {
   "id": "E01S01",
   "heading": "内·病房走廊·夜",
   "characters": [
    "林小满"
   ],
   "beats": [
    {
     "id": "E01S01B01",
     "kind": "action",
     "text": "夜里的病房走廊，日光灯一盏接一盏。林小满抱着病历夹从尽头走来，边走边翻。",
     "tag": "原文事实"
    },
    {
     "id": "E01S01B02",
     "kind": "action",
     "text": "她抬头看向七床的门牌，门虚掩着，里面没有监护仪的滴滴声。",
     "tag": "原文事实"
    },
    {
     "id": "E01S01B03",
     "kind": "action",
     "text": "画面文字：7",
     "tag": "原文事实"
    },
    {
     "id": "E01S01L01",
     "kind": "line",
     "speaker": "林小满",
     "text": "七床？",
     "tag": "原文事实"
    },
    {
     "id": "E01S01B04",
     "kind": "action",
     "text": "她推门。病床空着，被子掀开一半，输液管垂在地上还在滴。",
     "tag": "原文事实"
    },
    {
     "id": "E01S01L02",
     "kind": "line",
     "speaker": "林小满",
     "text": "七床的人呢？",
     "tag": "原文事实"
    },
    {
     "id": "E01S01B05",
     "kind": "action",
     "text": "她按下床头呼叫铃，没人应。她把病历夹夹到腋下，掀开被子，手按在床单上。",
     "tag": "原文事实"
    },
    {
     "id": "E01S01L03",
     "kind": "line",
     "speaker": "林小满",
     "text": "还是热的。",
     "tag": "原文事实"
    },
    {
     "id": "E01S01B06",
     "kind": "action",
     "text": "走廊尽头传来电梯到站的叮一声。她转身跑出病房。",
     "tag": "原文事实"
    },
    {
     "id": "E01S01B07",
     "kind": "action",
     "text": "音效：电梯到站的叮声；护士鞋在塑胶地板上的快步声。",
     "tag": "原文事实"
    }
   ]
  },
  {
   "id": "E01S02",
   "heading": "内·电梯口·夜",
   "characters": [
    "周岸",
    "林小满"
   ],
   "beats": [
    {
     "id": "E01S02B01",
     "kind": "action",
     "text": "电梯门正在合上，一只手从里面把门挡住。周岸从电梯里走出来，蓝白条病号服外面套着黑夹克，脚上是拖鞋。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02B02",
     "kind": "action",
     "text": "林小满在三米外刹住脚，病历夹差点掉。头顶一盏日光灯在闪。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L01",
     "kind": "line",
     "speaker": "周岸",
     "text": "小满。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L02",
     "kind": "line",
     "speaker": "林小满",
     "text": "你怎么在这？",
     "tag": "原文事实"
    },
    {
     "id": "E01S02B03",
     "kind": "action",
     "text": "周岸看了一眼她胸前的工牌，又看向她身后的走廊。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L03",
     "kind": "line",
     "speaker": "周岸",
     "text": "七床。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L04",
     "kind": "line",
     "speaker": "林小满",
     "text": "你是七床？",
     "tag": "原文事实"
    },
    {
     "id": "E01S02B04",
     "kind": "action",
     "text": "他抬起右手示意她小声，手腕上贴着一块留置针贴膏。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L05",
     "kind": "line",
     "speaker": "周岸",
     "text": "别喊。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L06",
     "kind": "line",
     "speaker": "林小满",
     "text": "病号服……你住院了？",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L07",
     "kind": "line",
     "speaker": "周岸",
     "text": "我不是来住院的。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02B05",
     "kind": "action",
     "text": "她上前一步，把病历夹抱紧。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L08",
     "kind": "line",
     "speaker": "林小满",
     "text": "两年。你一句话都没有。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L09",
     "kind": "line",
     "speaker": "周岸",
     "text": "回去，把护士站的门锁上。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02L10",
     "kind": "line",
     "speaker": "林小满",
     "text": "周岸！",
     "tag": "原文事实"
    },
    {
     "id": "E01S02B06",
     "kind": "action",
     "text": "音效：楼梯间防火门被撞开的闷响。",
     "tag": "原文事实"
    },
    {
     "id": "E01S02B07",
     "kind": "action",
     "text": "周岸的目光越过她的肩膀，落在防火门上。",
     "tag": "原文事实"
    }
   ]
  },
  {
   "id": "E01S03",
   "heading": "内·电梯口·夜",
   "characters": [
    "周岸",
    "林小满"
   ],
   "beats": [
    {
     "id": "E01S03B01",
     "kind": "action",
     "text": "防火门弹开，阿坤从楼梯间冲出来，黑色连帽衫兜帽压低，黑口罩，右手一把折叠刀。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03L01",
     "kind": "line",
     "speaker": "周岸",
     "text": "退后！",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B02",
     "kind": "action",
     "text": "周岸左手把林小满拨到身后，侧身让开第一刀，刀尖划过他的左袖口。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B03",
     "kind": "action",
     "text": "阿坤反手第二刀直刺，周岸右前臂下压格开，两人撞在电梯门上。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03L02",
     "kind": "line",
     "speaker": "林小满",
     "text": "小心——",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B04",
     "kind": "action",
     "text": "阿坤用肩膀顶开周岸，刀换到左手，再次逼近。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B05",
     "kind": "action",
     "text": "周岸抓住他持刀的手腕向下一带，右膝顶上去。折叠刀脱手，掉在地上转了半圈。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B06",
     "kind": "action",
     "text": "阿坤退两步，低头看了一眼地上的刀，又看了一眼周岸身后的林小满。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B07",
     "kind": "action",
     "text": "电梯指示灯叮了一声。阿坤转身撞开防火门，脚步声往楼下去。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B08",
     "kind": "action",
     "text": "周岸弯腰捡起折叠刀，合上。他回头看她。林小满背贴着墙，病历夹掉在脚边。",
     "tag": "原文事实"
    },
    {
     "id": "E01S03L03",
     "kind": "line",
     "speaker": "周岸",
     "text": "现在信了？",
     "tag": "原文事实"
    },
    {
     "id": "E01S03B09",
     "kind": "action",
     "text": "音效：防火门缓缓合上的气压声；日光灯镇流器的滋滋声。",
     "tag": "原文事实"
    }
   ]
  }
 ]
}
