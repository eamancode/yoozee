  "idPattern": "^[a-z0-9][a-z0-9-]{0,35}$",
  "versionPattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$",
  "contractPattern": "^[a-z0-9][a-z0-9.-]*@[0-9]+$"
