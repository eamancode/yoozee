{
  "$id": "speech.extract@1",
  "type": "object",
  "required": ["rows"],
  "x-contract": {
    "heading": "【受保护输出契约】",
    "layout": "lines",
    "items": "rows",
    "unit": "条声音",
    "format": "每次发言一行 JSON；不含已有镜头。无发言时仅输出 {\"empty\":true}。",
    "rowsIntro": "每行字段：",
    "requirement": "完整覆盖输入全部发言，逐字保留，保留重复发言及单字回应。"
  },
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene", "paragraph", "speaker", "kind", "text"],
        "properties": {
          "scene": { "type": "string", "description": "给定的运行场编号" },
          "paragraph": { "type": "integer", "description": "该场原文起始段号" },
          "paragraph_end": {
            "type": "integer",
            "description": "同一次发言跨段的结束段号，不跨段可省略"
          },
          "speaker": {
            "type": "string",
            "description": "原文说话人，旁白写旁白"
          },
          "kind": {
            "type": "string",
            "enum": ["dialogue", "voiceover", "narration"]
          },
          "text": {
            "type": "string",
            "description": "来源段落中的连续原文，不含开头说话人与表演括号"
          }
        }
      }
    }
  }
}
