{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoozee.dev/contracts/segment.schema.json",
  "title": "中性分段（一段 = 一次生成，段内多镜头）",
  "description": "不认厂商的分段描述。编译器把它翻译成某个模型的提示词；时长上限按项目所选模型从 models.json 取。2.0 新增：shot_ids 回指镜头表、story_span、profile、handles、warnings、continuity_bridge（同场拆段时后段必带）。1.0 字段全部保留，旧段照常编译。",
  "type": "object",
  "required": ["id", "scene", "dur", "mode", "shots"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^S[0-9]{2,3}[a-z]?$"},
    "scene": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "dur": {"type": "number", "exclusiveMinimum": 0},
    "mode": {"type": "string", "enum": ["lock_identity", "lock_first_frame", "text_only"]},
    "first_frame": {"type": "string"},
    "last_frame": {"type": "string"},
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "role"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string"},
          "role": {"type": "string", "enum": ["identity", "location", "plate", "prop", "frame", "motion"]},
          "note": {"type": "string"},
          "state": {"type": "string", "description": "镜头层的演出状态（湿、血、破损），编译时拼在身份后面"}
        }
      }
    },
    "voices": {
      "type": "array",
      "items": {"type": "object", "required": ["character", "file"], "additionalProperties": false, "properties": {"character": {"type": "string"}, "file": {"type": "string"}}}
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "text"],
        "additionalProperties": false,
        "properties": {
          "at": {"type": "number", "minimum": 0},
          "size": {"type": "string"},
          "camera": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["speaker", "text"],
              "additionalProperties": false,
              "properties": {
                "speaker": {"type": "string"},
                "text": {"type": "string", "minLength": 1},
                "vo": {"type": "boolean"},
                "delivery": {"type": "string"},
                "line_id": {"type": "string", "description": "回指剧本台词 id"},
                "timbre": {"type": "string", "description": "音色（来自 bible voice_profile：声线 + 线路质感）"},
                "pace": {"type": "string"},
                "tone": {"type": "string"},
                "emotion": {"type": "string"},
                "placement": {"type": "string"}
              }
            }
          },
          "sound": {"type": "string"},
          "end_state": {"type": "string"},
          "shot_id": {"type": "string", "description": "回指镜头表的镜头 id"},
          "risk_tags": {"type": "array", "items": {"type": "string"}},
          "start_state": {"type": "string"},
          "purpose": {"type": "string"},
          "expression": {"type": "string", "description": "分秒表演链（由情绪弧展开或手写节拍）"},
          "expression_terms": {"type": "array", "items": {"type": "string"}},
          "composition": {"type": "string"},
          "transition": {"type": "object", "additionalProperties": false, "properties": {"in": {"type": "string"}, "out": {"type": "string"}, "cut_point": {"type": "string"}}},
          "vo": {"type": "string"},
          "positions": {"type": "string", "description": "本镜站位句（人物在哪、距离、朝向、前后景）"},
          "anchors": {"type": "string", "description": "本镜可见场景锚点与物件状态句"},
          "motion": {"type": "string", "description": "本镜运动方向句"},
          "light_full": {"type": "string", "description": "灯光七项句"}
        }
      }
    },
    "cast": {"type": "array", "items": {"type": "object", "required": ["name", "lock"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "lock": {"type": "array", "items": {"type": "string"}}}}, "description": "没有身份参考图的在场人物的外貌声明（lock_card 前几条），编译写进段头"},
    "screen_text": {"type": "array", "items": {"type": "string"}, "description": "本段镜头引用的、剧本登记过的画面文字；⚠️ 与约束据此放行"},
    "jimeng": {
      "type": "object",
      "additionalProperties": false,
      "description": "即梦小节头（由 pack 从剧本 / 镜头表 / 资产圣经填）",
      "properties": {
        "narrative_span": {"type": "string"},
        "function": {"type": "string"},
        "strategy": {"type": "string"},
        "atmosphere": {"type": "string"},
        "light_source": {"type": "string"},
        "sound_bed": {"type": "string"},
        "group_variation": {"type": "string"}
      }
    },
    "sound": {"type": "string"},
    "rules": {"type": "string"},
    "hook": {"type": "string"},
    "lang": {"type": "string"},
    "shot_ids": {"type": "array", "items": {"type": "string"}},
    "story_span": {"type": "string", "description": "叙事时间跨度与压缩方式（省略剪辑 / 微蒙太奇 / 图形匹配 / 声音匹配）"},
    "profile": {"type": "string"},
    "reanchor": {"type": "string", "description": "中段再锚定文本；不写由编译器按默认生成"},
    "density": {"type": "string", "enum": ["tight", "standard", "dense"]},
    "handles": {
      "type": "array",
      "description": "本段参考句柄声明（按段编号），编译器生成；人工写粘贴版时也可直接给",
      "items": {"type": "object", "required": ["tag", "text"], "additionalProperties": false, "properties": {"tag": {"type": "string"}, "text": {"type": "string"}}}
    },
    "warnings": {"type": "array", "items": {"type": "string"}, "description": "由 risk_tags 汇总的 ⚠️ 文案"},
    "continuity_bridge": {
      "type": "object",
      "required": ["prev_segment", "handoff_state", "shared_refs"],
      "additionalProperties": false,
      "description": "同一场拆成多段时，后段必带",
      "properties": {
        "prev_segment": {"type": "string"},
        "handoff_state": {"type": "string", "description": "前段末镜 end_state 原文"},
        "shared_refs": {"type": "array", "items": {"type": "string"}, "description": "与前段相同的参考文件，顺序即编号"},
        "bridge_frame": {"type": "string", "description": "前段选中候选的末帧（yz-shoot 选中后补）"},
        "bridge_clip": {"type": "string", "description": "前段选中候选的末 1～2 秒（可选 motion 参考）"},
        "reanchor_text": {"type": "string"},
        "shared_bed": {"type": "string", "description": "两段共用的环境声"}
      }
    }
  }
}
