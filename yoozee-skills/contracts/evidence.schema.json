{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoozee.dev/contracts/evidence.schema.json",
  "title": "证据",
  "description": "一条证据 = 一把尺子对一个候选（或成片、或一份文本产物）量出来的结果。进度由证据推导，不由人勾选。2.0 新增 kind：check（文本验证器）、score（质量自评，只记录）、cold_read、action（动作连续性）、handoff（桥段交接）。",
  "type": "object",
  "required": ["segment", "kind", "passed"],
  "additionalProperties": false,
  "properties": {
    "segment": {"type": "string", "description": "段号；成片写 FILM；文本产物写 brief / story / script / bible / shotlist"},
    "take": {"type": "string"},
    "kind": {
      "type": "string",
      "enum": ["transcript", "frames", "faces", "levels", "voice", "pick", "gate", "review", "delivery", "acceptance", "check", "score", "cold_read", "action", "handoff"]
    },
    "passed": {"type": ["boolean", "null"]},
    "metrics": {"type": "object"},
    "file": {"type": "string"},
    "note": {"type": "string"},
    "at": {"type": "string"}
  }
}
