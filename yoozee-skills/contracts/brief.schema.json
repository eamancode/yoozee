{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoozee.dev/contracts/brief.schema.json",
  "title": "需求文档",
  "description": "只有 status 为「已确认」或「默认，已授权」的条目才能拿去花钱。用户原话原样记、带日期。2.0 新增：剧本来源、风格档案、入口类型、提示词密度、速产参数、分集目标。",
  "type": "object",
  "required": ["title", "video_model", "run_mode", "style_profile", "script_mode"],
  "additionalProperties": false,
  "$defs": {
    "status": {"type": "string", "enum": ["已确认", "默认，待确认", "默认，已授权", "待答"]},
    "fact": {
      "type": "object",
      "required": ["value", "status"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "quote": {"type": "string", "description": "用户原话"},
        "date": {"type": "string"}
      }
    }
  },
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "video_model": {"type": "string", "description": "生成模型 ID，取自 models.json；默认 seedance-2.5（一段最长 30 秒）"},
    "run_mode": {"type": "string", "enum": ["until_video", "review_from_assets", "every_step"], "description": "生成模式：until_video 跑到出视频前；review_from_assets 资产我要过目；every_step 每步都问我"},
    "style_profile": {"type": "string", "description": "风格档案 id，取自 profiles/：live-realism（默认）、duanju-shiga、anime-3d、action-epic、game-ip 或用户派生档案"},
    "script_mode": {"type": "string", "enum": ["original", "adapt", "given"], "description": "original 原创（yz-story 五阶段或速产）；adapt 改编小说（先事实账本）；given 已有剧本"},
    "entry": {"type": "string", "enum": ["script", "image", "storyboard_grid", "reference_video", "idea"], "description": "入口类型：剧本 / 一张图 / 分镜板 / 参考视频 / 一句话创意"},
    "prompt_density": {"type": "string", "enum": ["tight", "standard", "dense"], "description": "提示词密度；不写则取档案默认"},
    "purpose": {"$ref": "#/$defs/fact"},
    "platform": {"$ref": "#/$defs/fact"},
    "duration": {"$ref": "#/$defs/fact"},
    "taste": {"$ref": "#/$defs/fact"},
    "budget": {"$ref": "#/$defs/fact"},
    "acceptance": {"$ref": "#/$defs/fact"},
    "duanju_mode": {
      "type": "object",
      "additionalProperties": false,
      "description": "短剧速产参数（script_mode=original 且走速产时）",
      "properties": {
        "market": {"type": "string", "enum": ["domestic", "overseas"]},
        "channel": {"type": "string", "enum": ["male", "female"]},
        "packs": {"type": "array", "items": {"type": "string"}, "description": "题材配方包，可复合"},
        "episodes": {"type": "integer", "minimum": 1},
        "episode_seconds": {"type": "integer", "minimum": 30},
        "paywall": {"type": "boolean", "description": "是否付费卡点模式"}
      }
    },
    "episode_seconds": {"type": "number", "minimum": 5, "maximum": 3600, "description": "每集目标时长（秒），柚子项目设置里填；生成分镜的提示词和 R-SEG-008 读它（episodes[].target_seconds 优先）"},
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["no"],
        "additionalProperties": false,
        "properties": {
          "no": {"type": "integer", "minimum": 1},
          "target_seconds": {"type": "number"},
          "hook_requirement": {"type": "string"}
        }
      }
    },
    "items": {
      "type": "array",
      "description": "要求与反馈（R-）",
      "items": {
        "type": "object",
        "required": ["id", "content", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^R-[0-9]{3}$"},
          "content": {"type": "string"},
          "quote": {"type": "string"},
          "date": {"type": "string"},
          "segments": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string"}
        }
      }
    },
    "not_doing": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "blocking", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^Q-[0-9]{3}$"},
          "question": {"type": "string"},
          "blocking": {"type": "boolean"},
          "status": {"type": "string"}
        }
      }
    },
    "decided_for_you": {"type": "array", "items": {"type": "string"}}
  }
}
