{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoozee.dev/contracts/profile.schema.json",
  "title": "风格档案",
  "description": "把互相矛盾的作者口味变成数据：配额、禁令、风格块、光线政策、表演粒度、色彩、密度。一个项目只选一个档案；验证器只认档案字段，不认作者名。",
  "type": "object",
  "required": ["id", "label", "medium", "style_block", "quotas", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "label": {"type": "string"},
    "extends": {"type": "string"},
    "source": {"type": "string"},
    "medium": {"type": "string", "enum": ["live_action", "anime_3d", "anime_2d", "stylized", "game_cg"]},
    "style_block": {"type": "object", "required": ["zh"], "additionalProperties": false, "properties": {"zh": {"type": "string"}, "en": {"type": "string"}}},
    "acting_block": {"type": "object", "additionalProperties": false, "properties": {"zh": {"type": "string"}, "en": {"type": "string"}}},
    "performance_grain": {"type": "string", "enum": ["visible_action", "micro"]},
    "camera_default": {"type": "string", "description": "对话默认机位，如 X2（侧 45）"},
    "camera_follows_emotion": {"type": "boolean"},
    "emotion_arc_required": {"type": "boolean", "description": "含台词或表演的人物镜头必须有 emotion_arc 或手写节拍（R-SHOT-026）"},
    "light_policy": {"type": "string", "enum": ["practicals_only", "motivated", "stylized"]},
    "prompt_density": {"type": "string", "enum": ["tight", "standard", "dense"]},
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "description": "比例为 0～1 的占比，_max 为次数上限；缺省不检查",
      "properties": {
        "normal_max": {"type": "number"},
        "side45_min": {"type": "number"},
        "side45_max": {"type": "number"},
        "side90_max": {"type": "number"},
        "dutch_max": {"type": "integer"},
        "extreme_low_max": {"type": "integer"},
        "extreme_high_max": {"type": "integer"},
        "shake_violent_max": {"type": "integer"},
        "fixed_max": {"type": "number"},
        "closeup_max": {"type": "number"},
        "non_person_min": {"type": "number"},
        "non_person_max": {"type": "number"},
        "group_wide_min": {"type": "number"},
        "min_angles": {"type": "integer"},
        "min_moves": {"type": "integer"},
        "consecutive_same_move_max": {"type": "integer"},
        "consecutive_same_size_max": {"type": "integer"},
        "heavy_moves": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "one_take_allowed": {"type": "boolean"},
        "standing_talk_max_sec": {"type": "number"},
        "big_action_isolated": {"type": "boolean"},
        "big_action_sec": {"type": "array", "items": {"type": "number"}},
        "reaction_after_hammer": {"type": "boolean"},
        "dialogue_open_size": {"type": "array", "items": {"type": "string"}},
        "shot_time_code": {"type": "boolean"},
        "max_move_axes": {"type": "integer"},
        "no_rotation_at_z1_z3": {"type": "boolean"},
        "one_line_one_shot": {"type": "boolean"},
        "bgm_allowed": {"type": "boolean", "const": false},
        "adjacent_size_min_gap": {"type": "integer"},
        "indoor_light_anchor_required": {"type": "boolean"},
        "expression_min_sec": {"type": "number"},
        "group_variation_required": {"type": "boolean"}
      }
    },
    "color": {"type": "object", "additionalProperties": true},
    "lens_policy": {"type": "object", "additionalProperties": true},
    "space_policy": {"type": "object", "additionalProperties": true},
    "vfx_policy": {"type": "object", "additionalProperties": true},
    "asset_tier_policy": {"type": "object", "additionalProperties": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
